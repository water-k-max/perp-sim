# Read-only Hideki testnet configuration (chain 50383). No private key is needed.
# WALLET_ADDRESS is public; blank means hypothetical preflight analysis.
# CHAIN_ID labels the datasets this tool writes and caches. It cannot move a read: those go through
# the chain object in src/client.ts. If the two differ the interface says so instead of hiding it.
WALLET_ADDRESS=
CHAIN_ID=50383
RPC_URL=https://api.hideki2.infra.testnet.somnia.network
WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
