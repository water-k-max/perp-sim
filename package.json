{
  "name": "perp-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "description": "Backtester and pre-trade simulator for dreamDEX perps, built on the protocol's own exported arithmetic.",
  "scripts": {
    "dev": "tsx src/bin/web.ts",
    "test:web": "tsx --test src/backtest-api.test.ts",
    "probe:markets": "tsx src/bin/probe-markets.ts",
    "backtest": "tsx src/bin/backtest.ts",
    "preflight": "tsx src/bin/preflight.ts",
    "validate": "tsx src/bin/validate.ts",
    "test:units": "tsx --test src/units.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.32.1",
    "dotenv": "^18.0.8",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
